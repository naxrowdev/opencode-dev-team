{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "tech-lead",
  "instructions": [
    "docs/context/STATE.md"
  ],
  "tool_output": {
    "max_lines": 1000,
    "max_bytes": 32768
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 25000
    },
    "buffer": "15%"
  },
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      }
    }
  },
  "permissions": [
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "npm run lint",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "npm run lint:*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "npm run test",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "npm run test:*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "npm run build",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "npm run build:*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "npm run typecheck",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "npm run typecheck:*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "npx drizzle-kit generate",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "npx drizzle-kit generate:*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "npx drizzle-kit check",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "npx drizzle-kit check:*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "docker compose ps",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "docker compose ps:*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "docker compose logs",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "docker compose logs:*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git status",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git status:*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git status *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git diff",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git diff:*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git diff *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git log",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git log:*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git log *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git show",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git show:*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git show *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git branch",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git branch:*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git branch *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git remote -v",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "ls",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "ls:*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "ls *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "ls -l",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "ls -la",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "ls -lh",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "ls -lh",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "ls -a",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "cat",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "cat:*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "cat *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "head",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "head:*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "head *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "tail",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "tail:*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "tail *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "grep",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "grep:*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "grep *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "find",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "find:*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "find *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "stat",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "stat:*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "stat *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "*DROP DATABASE*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*DROP TABLE*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*TRUNCATE*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*DELETE FROM*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "dropdb*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "psql *DROP*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "psql *TRUNCATE*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "psql *DELETE*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm -rf*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "* rm -rf *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm -r*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "* rm -r *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm -f*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "* rm -f *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "shred*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "wipe*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "eval *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "exec *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "source *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": ". *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*| *sh",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*| *bash",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*| *zsh",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "sh *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "bash *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "zsh *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "./*.sh",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*/*.sh",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "curl *| *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "wget *| *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "npm exec*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "npx *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "chmod +x*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "chmod 7*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "chown*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "chgrp*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "sudo *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "su *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "doas *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git push --force*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git push --delete*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git push *:refs/*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git reset --hard*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git clean*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git tag -d*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git tag --delete*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "docker run --privileged*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "docker run *--user=root*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "docker exec *--user=root*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "docker commit*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "docker save*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "docker export*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "npm publish *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "docker push *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "kubectl delete *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "kubectl apply *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "terraform apply *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "terraform destroy *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "terraform plan -destroy*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "ansible-playbook *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "npx drizzle-kit push*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "drizzle-kit push*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "npx drizzle-kit migrate*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "drizzle-kit migrate*",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "allow"
    },
    {
      "action": "write",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "write",
      "resource": "*.env.*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "cat *.env*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "grep * *.env*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    }
  ]
}
